  "semantic": {
    "windowChrome": "{color.neutral.base}",
    "titleBar": "{color.neutral.700}",
    "info": "{color.blue.base}",
    "success": "{color.green.base}",
    "warning": "{color.gold.base}",
    "danger": "{color.red.500}",
    "rideRed": "{color.rose.base}",
    "waterTeal": "{color.aqua.base}"
  },
  "typography": {
    "fontStack": "'RCT2 Sprite Font', 'MS Sans Serif', system-ui, sans-serif",
    "sizes": {
      "tiny": {
        "px": 6,
        "lineHeight": 6
      },
      "small": {
        "px": 10,
        "lineHeight": 10
      },
      "medium": {
        "px": 10,
        "lineHeight": 10,
        "weight": "semibold"
      }
    },
    "decoration": {
      "outline": "1px highlight (sunnyOutline) + 1px shadow (shadowOutline)",
      "darkness": [
        "regular",
        "dark",
        "extraDark"
      ]
    }
  },
  "space": {
    "bevel": "1px",
    "rowUnit": "12px",
    "gutter": "2px",
    "tabWidth": "31px",
    "tabHeight": "27px"
  },
  "radius": {
    "default": "0px",
    "note": "RCT2 is square-cornered; use 0. Modernized homage may use 2-3px."
  },
  "elevation": {
    "method": "bevel, not shadow",
    "raised": "highlight top+left, shadow bottom+right",
    "sunken": "shadow top+left, highlight bottom+right (+lighten fill)"
  },
  "dimensions": {
    "titleBar": 13,
    "titleBarLarge": 24,
    "closeButton": 10,
    "scrollbar": 10,
    "rowHeight": 12,
    "controlHeight": 12
  }
}